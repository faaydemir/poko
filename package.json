{
  "name": "poko",
  "version": "1.0.0",
  "description": "Port control for macOS \u2014 local services in your menu bar, shared with AI agents through MCP.",
  "scripts": {
    "start": "node server/daemon.mjs",
    "mcp": "node server/mcp.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "build": "bash scripts/build.sh",
    "package": "bash scripts/package.sh",
    "screenshots": "npm run build && dist/Poko.app/Contents/MacOS/Poko --demo-screenshots docs/images",
    "install:local": "bash scripts/install.sh",
    "lint": "eslint .",
    "knip": "knip",
    "quality": "npm run lint && npm run knip && bash scripts/swift-quality.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jsonc-parser": "3.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "knip": "6.47.0"
  }
}
